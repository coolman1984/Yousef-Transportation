    "state": "trip.first"
   },
   "steps": [
    {
     "k": "go",
     "page": "trips",
     "until": {
      "route": "trips"
     }
    },
    {
     "k": "click",
     "target": "trips.new",
     "until": {
      "target": "trips.form"
     }
    },
    {
     "k": "choose",
     "target": "trips.category",
     "until": {
      "filled": "trips.category"
     }
    },
    {
     "k": "type",
     "target": "trips.destination",
     "until": {
      "filled": "trips.destination"
     }
    },
    {
     "k": "click",
     "target": "trips.save",
     "until": {
      "gone": "trips.form"
     }
    },
    {
     "k": "done"
    }
   ]
  },
