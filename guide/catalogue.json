 "guides": [
  {
   "id": "first-look",
   "cat": "start",
   "perm": "overview.view",
   "minutes": 1,
   "requires": [],
   "steps": [
    {
     "k": "go",
     "page": "overview",
     "until": {
      "route": "overview"
     }
    },
    {
     "k": "tip"
    },
    {
     "k": "done"
    }
   ]
  },
  {
   "id": "create-trip",
   "cat": "trips",
   "perm": "trips.create",
   "minutes": 3,
   "requires": [],
